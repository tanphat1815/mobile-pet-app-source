{
  "name": "mobile-pet-app",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/native": "~7.0.14",
    "@react-navigation/native-stack": "~7.2.0",
    "axios": "~1.7.9",
    "expo": "~57.0.18",
    "expo-device": "~57.0.1",
    "expo-haptics": "~57.0.2",
    "expo-local-authentication": "~57.0.2",
    "expo-notifications": "~57.0.15",
    "expo-status-bar": "~57.0.1",
    "react": "^19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zustand": "~5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.0.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --no-install",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:dev": "eas build --profile development --non-interactive",
    "build:preview": "eas build --profile preview --non-interactive",
    "build:production": "eas build --profile production --non-interactive",
    "build:simulator": "eas build --profile simulator --platform ios --non-interactive",
    "submit:production": "eas submit --platform ios --latest --non-interactive",
    "submit:android:production": "eas submit --platform android --latest --non-interactive",
    "version:patch": "node ./scripts/bump-version.js patch",
    "version:minor": "node ./scripts/bump-version.js minor",
    "version:major": "node ./scripts/bump-version.js major"
  },
  "private": true
}
